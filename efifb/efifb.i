static inline __attribute__((__gnu_inline__)) __attribute__((__unused__))
__attribute__((no_instrument_function)) enum efi_secureboot_mode
efi_get_secureboot_mode(efi_get_variable_t *get_var)
{
	u8 secboot, setupmode = 0;
	efi_status_t status;
	unsigned long size;

	size = sizeof(secboot);
	status = get_var(
		L"SecureBoot",
		&((efi_guid_t){ { (0x8be4df61) & 0xff,
				  ((0x8be4df61) >> 8) & 0xff,
				  ((0x8be4df61) >> 16) & 0xff,
				  ((0x8be4df61) >> 24) & 0xff, (0x93ca) & 0xff,
				  ((0x93ca) >> 8) & 0xff, (0x11d2) & 0xff,
				  ((0x11d2) >> 8) & 0xff, 0xaa, 0x0d, 0x00,
				  0xe0, 0x98, 0x03, 0x2b, 0x8c } }),
		((void *)0), &size, &secboot);
	if (status == (14 | (1UL << (64 - 1))))
		return efi_secureboot_mode_disabled;
	if (status != 0)
		return efi_secureboot_mode_unknown;

	size = sizeof(setupmode);
	get_var(L"SetupMode",
		&((efi_guid_t){ { (0x8be4df61) & 0xff,
				  ((0x8be4df61) >> 8) & 0xff,
				  ((0x8be4df61) >> 16) & 0xff,
				  ((0x8be4df61) >> 24) & 0xff, (0x93ca) & 0xff,
				  ((0x93ca) >> 8) & 0xff, (0x11d2) & 0xff,
				  ((0x11d2) >> 8) & 0xff, 0xaa, 0x0d, 0x00,
				  0xe0, 0x98, 0x03, 0x2b, 0x8c } }),
		((void *)0), &size, &setupmode);
	if (secboot == 0 || setupmode == 1)
		return efi_secureboot_mode_disabled;
	return efi_secureboot_mode_enabled;
}

