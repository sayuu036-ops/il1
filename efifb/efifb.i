#define xchg(ptr, ...)                                                     \
	({                                                                 \
		typeof(ptr) __ai_ptr = (ptr);                              \
		kcsan_mb();                                                \
		instrument_atomic_read_write(__ai_ptr, sizeof(*__ai_ptr)); \
		raw_xchg(__ai_ptr, __VA_ARGS__);                           \
	})

#define xchg_acquire(ptr, ...)                                             \
	({                                                                 \
		typeof(ptr) __ai_ptr = (ptr);                              \
		instrument_atomic_read_write(__ai_ptr, sizeof(*__ai_ptr)); \
		raw_xchg_acquire(__ai_ptr, __VA_ARGS__);                   \
	})

#define xchg_release(ptr, ...)                                             \
	({                                                                 \
		typeof(ptr) __ai_ptr = (ptr);                              \
		kcsan_release();                                           \
		instrument_atomic_read_write(__ai_ptr, sizeof(*__ai_ptr)); \
