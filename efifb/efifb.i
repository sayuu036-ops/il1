	((efi_guid_t){ { (a) & 0xff, ((a) >> 8) & 0xff, ((a) >> 16) & 0xff, \
			 ((a) >> 24) & 0xff, (b) & 0xff, ((b) >> 8) & 0xff, \
			 (c) & 0xff, ((c) >> 8) & 0xff, d } })

