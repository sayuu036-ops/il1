__fb_pad_aligned_buffer(u8 *dst, u32 d_pitch, const u8 *src, u32 s_pitch,
			u32 height)
{
	u32 i, j;

	d_pitch -= s_pitch;

	for (i = height; i--;) {
		for (j = 0; j < s_pitch; j++)
			*dst++ = *src++;
		dst += d_pitch;
	}
}

